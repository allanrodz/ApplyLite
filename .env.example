API_PORT=4310
WEB_ORIGIN=http://localhost:5173
DATABASE_PATH=./data/apply-lite.db
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:4b
BROWSER_HEADLESS=false

STORAGE_PATH=./storage

# Optional background CV enhancement only; uploads do not wait for AI.
CV_AI_TIMEOUT_MS=180000

# Default is entirely local. Configure cloud consent and your own key in System.
AI_MODE=local_only
CLOUD_AI_CONSENT=false
GROQ_MODEL=openai/gpt-oss-20b
# Optional server-only environment override (never commit an actual key):
# GROQ_API_KEY=
